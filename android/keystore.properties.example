# Copy to android/keystore.properties (gitignored) and fill in.
# Generate a key once (keep it forever — Play requires the same upload key):
#   keytool -genkeypair -v -keystore ~/pogo-upload.jks -alias pogo -keyalg RSA -keysize 2048 -validity 10000
storeFile=/home/kill/pogo-upload.jks
storePassword=CHANGE_ME
keyAlias=pogo
keyPassword=CHANGE_ME
